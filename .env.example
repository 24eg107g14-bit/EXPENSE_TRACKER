# Copy this file to .env and fill in your values.
# .env is git-ignored so real credentials are never committed.

# ── Database ──────────────────────────────────────────────────────────────────
# Option 1: MySQL (default)
DB_URL=jdbc:mysql://localhost:3306/expense_tracker?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Option 2: Embedded H2 database (zero setup, no MySQL required)
# DB_URL=jdbc:h2:file:./data/pocketbook;MODE=MySQL;DB_CLOSE_DELAY=-1
# DB_USER=sa
# DB_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate one with:
#   powershell -Command "[Convert]::ToBase64String((1..48 | %{ [byte](Get-Random -Max 256) }))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
# Use * for local development or set the exact URL in production.
CORS_ORIGINS=http://localhost:5500
