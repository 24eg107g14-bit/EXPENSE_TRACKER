# Copy this file to .env and fill in your values.
# .env is git-ignored so real credentials are never committed.

# ── Database ──────────────────────────────────────────────────────────────────
# Full JDBC URL (the database is created automatically if it does not exist)
DB_URL=jdbc:mysql://localhost:3306/expense_tracker?createDatabaseIfNotExist=true&serverTimezone=UTC

# MySQL credentials
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate one with:
#   powershell -Command "[Convert]::ToBase64String((1..48 | %{ [byte](Get-Random -Max 256) }))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
# Use * for local development or set the exact URL in production.
CORS_ORIGINS=http://localhost:5500
